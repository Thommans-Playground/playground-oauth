@startuml uc-01-register-with-password
!include ../architecture/_style.puml
title UC-01: Register with Email and Password

actor Actor

box "Driving Adapter" #LightBlue
participant "REST Router" as REST
end box

box "Hexagon" #LightYellow
participant "RegisterWithPassword\n(application)" as UseCase
participant "User\n(domain)" as Domain
participant "PasswordHasher\n(port)" as Hasher
participant "UserRepository\n(port)" as Port
end box

box "Driven Adapter" #LightGreen
participant "PostgresUserRepository" as Postgres
database "Postgres" as DB
end box

Actor -> REST : POST /auth/register
REST -> UseCase : [UC-01.1-2] RegisterWithPasswordInput

UseCase -> Port : [UC-01.3] get_by_email(email)
Port -> Postgres : get_by_email(email)
Postgres -> DB : SELECT
DB --> Postgres : none
Postgres --> Port : none
Port --> UseCase : none

alt email free
  UseCase -> Domain : [UC-01.4] User.register(email, password, id)
  Domain -> Hasher : hash(password)
  Hasher --> Domain : PasswordCredential
  Domain --> UseCase : User (or validation error)

  alt valid
    UseCase -> Port : [UC-01.5] save(user)
    Port -> Postgres : [UC-01.6] save(user)
    Postgres -> DB : INSERT
    DB --> Postgres : ok
    Postgres --> Port : ok
    Port --> UseCase : ok
    UseCase --> REST : [UC-01.7] User
    REST --> Actor : 201 Created + User
  else invalid
    UseCase --> REST : [UC-01.4a] ValidationError
    REST --> Actor : 422 Unprocessable Entity
  end
else email taken
  UseCase --> REST : [UC-01.3a] AlreadyExists
  REST --> Actor : 409 Conflict
end

note over UseCase, DB
  [UC-01.n] tags map to Main Success Scenario step n
  in uc-01-register-with-password.md ("3a"/"4a" = the matching Extensions).
end note

@enduml
