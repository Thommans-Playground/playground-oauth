@startuml uc-02-login-with-password
!include ../architecture/_style.puml
title UC-02: Log In with Email and Password

actor Actor

box "Driving Adapter" #LightBlue
participant "REST Router" as REST
end box

box "Hexagon" #LightYellow
participant "LoginWithPassword\n(application)" as UseCase
participant "PasswordHasher\n(port)" as Hasher
participant "UserRepository\n(port)" as UserPort
participant "SessionRepository\n(port)" as SessionPort
end box

box "Driven Adapters" #LightGreen
participant "PostgresUserRepository" as Postgres
participant "RedisSessionRepository" as Redis
database "Postgres" as PGDB
database "Redis" as RDB
end box

Actor -> REST : POST /auth/login
REST -> UseCase : [UC-02.1-2] LoginWithPasswordInput

UseCase -> UserPort : [UC-02.3] get_by_email(email)
UserPort -> Postgres : get_by_email(email)
Postgres -> PGDB : SELECT
PGDB --> Postgres : row or none
Postgres --> UserPort : User or none
UserPort --> UseCase : User or none

alt user found
  UseCase -> Hasher : [UC-02.4] verify(password, user.credential)

  alt password matches
    UseCase -> SessionPort : [UC-02.5-6] save(Session.start(user_id, "password"))
    SessionPort -> Redis : save(session)
    Redis -> RDB : SET session
    RDB --> Redis : ok
    Redis --> SessionPort : ok
    SessionPort --> UseCase : Session
    UseCase --> REST : [UC-02.8] Session
    REST --> Actor : 200 OK + Set-Cookie: session_id
  else password mismatch
    UseCase --> REST : [UC-02.4a] InvalidCredentials
    REST --> Actor : 401 Unauthorized
  end
else user not found
  UseCase --> REST : [UC-02.3a] InvalidCredentials
  REST --> Actor : 401 Unauthorized
end

note over UseCase, RDB
  [UC-02.n] tags map to Main Success Scenario step n
  in uc-02-login-with-password.md ("3a"/"4a" = the matching Extensions).
  Steps 3a and 4a return the identical error, deliberately.
end note

@enduml
